generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}


enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model School {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String       @default("India")
  logoUrl     String?
  website     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

    users       User[]
  students    Student[]
  teachers    Teacher[]
  classes     Class[]
  subjects    Subject[]
  notices   Notice[]
  admissionEnquiries AdmissionEnquiry[]

  @@index([slug])
}

model User {
  id          String       @id @default(cuid())
  schoolId    String?
  name        String
  email       String       @unique
  passwordHash String
  role        UserRole
  status      UserStatus   @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School?      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student?
  teacher     Teacher?

  @@index([schoolId])
  @@index([role])
}

model Student {
  id              String       @id @default(cuid())
  schoolId        String
  userId          String?      @unique
  admissionNumber String
  firstName       String
  lastName        String?
  dateOfBirth     DateTime?
  gender          String?
  phone           String?
  address         String?
  classId         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  class           Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([classId])
}

model Teacher {
  id              String       @id @default(cuid())
  schoolId        String
  userId          String?      @unique
  employeeNumber  String
  firstName       String
  lastName        String?
  qualification   String?
  department      String?
  phone           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  classes         TeacherClass[]

  @@unique([schoolId, employeeNumber])
  @@index([schoolId])
}

model Class {
  id          String       @id @default(cuid())
  schoolId    String
  name        String
  section     String
  academicYear String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students    Student[]
  subjects    ClassSubject[]
  teachers    TeacherClass[]

  @@unique([schoolId, name, section, academicYear])
  @@index([schoolId])
}

model Subject {
  id          String       @id @default(cuid())
  schoolId    String
  name        String
  code        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes     ClassSubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
}


model ClassSubject {
  classId     String
  subjectId   String

  class       Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
  @@index([subjectId])
}

model TeacherClass {
  teacherId   String
  classId     String

  teacher     Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class       Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([teacherId, classId])
  @@index([classId])
}


model Notice {
  id          String    @id @default(cuid())
  schoolId    String

  title       String
  description String?
  content     String

  category    String    @default("General")
  attachmentUrl String?

  published   Boolean   @default(false)
  publishedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([published])
  @@index([publishedAt])
}

model AdmissionEnquiry {
  id          String   @id @default(cuid())
  schoolId    String

  studentName String
  parentName  String
  phone       String
  email       String?
  className   String
  message     String?

  status      String   @default("NEW")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, phone])
  @@index([schoolId])
  @@index([status])
  @@index([createdAt])
}
